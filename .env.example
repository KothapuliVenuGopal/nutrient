# ==========================================
# Nutrient – The Super Food (.env.example)
# ==========================================

# Core Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-django-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL on macOS)
DB_ENGINE=django.db.backends.mysql
DB_NAME=nutrient_db
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Restaurant Identity & Contact Info
RESTAURANT_NAME="Nutrient – The Super Food"
RESTAURANT_TAGLINE="Eat Clean. Stay Strong. Live Better."
RESTAURANT_PHONE="+91 7993476624"
RESTAURANT_LOCATION="Hyderabad, Telangana, India"
